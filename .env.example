# ------------------------------------------------------------------------------
# CODE DUNGEON - ENVIRONMENT CONFIGURATION TEMPLATE
# ------------------------------------------------------------------------------

# ─── SUPABASE SETTINGS ────────────────────────────────────────────────────────
# Description: Supabase project API URL.
SUPABASE_URL=https://your-project-id.supabase.co

# Description: Supabase service_role JWT key (NOT the anon key).
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── SERVER SETTINGS ──────────────────────────────────────────────────────────
# Description: Port the Express backend runs on.
PORT=5000

# Description: Secret string used to sign and verify JSON Web Tokens (JWT).
JWT_SECRET=your_jwt_signing_secret_here

# ─── ORGANIZER SETTINGS ────────────────────────────────────────────────────────
# Description: Password code needed to log into the Admin Command Dashboard.
ADMIN_SECRET=your_custom_admin_secret_here

# ─── CORS SETTINGS ───────────────────────────────────────────────────────────
# Description: The allowed Origin URL for incoming HTTP and WebSocket connections.
CLIENT_ORIGIN=http://localhost:3002

# ─── JUDGE SETTINGS ───────────────────────────────────────────────────────────
# Description: The API endpoint of the C++ Judge Server.
JUDGE_SERVER_URL=http://localhost:5001
