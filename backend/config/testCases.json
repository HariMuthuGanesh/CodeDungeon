{
  "1": {
    "title": "The Forgotten Gate",
    "description": "Print numbers from 1 to N on separate lines",
    "cases": [
      { "input": "5", "expected": "1\n2\n3\n4\n5\n" },
      { "input": "1", "expected": "1\n" },
      { "input": "3", "expected": "1\n2\n3\n" }
    ]
  },
  "2": {
    "title": "Crystal Cavern",
    "description": "Reverse a given string",
    "cases": [
      { "input": "hello", "expected": "olleh\n" },
      { "input": "dungeon", "expected": "noegnud\n" },
      { "input": "A", "expected": "A\n" }
    ]
  },
  "3": {
    "title": "Forest of Arrays",
    "description": "Find maximum and minimum element in an array",
    "cases": [
      { "input": "5\n1 2 3 4 5", "expected": "5 1\n" },
      { "input": "4\n10 -5 20 0", "expected": "20 -5\n" },
      { "input": "1\n42", "expected": "42 42\n" }
    ]
  },
  "4": {
    "title": "The Ancient Library",
    "description": "Recursive factorial of N",
    "cases": [
      { "input": "5", "expected": "120\n" },
      { "input": "0", "expected": "1\n" },
      { "input": "1", "expected": "1\n" },
      { "input": "7", "expected": "5040\n" }
    ]
  },
  "5": {
    "title": "Boss Chamber",
    "description": "Sort student records descending by marks",
    "cases": [
      { "input": "3\nAlice 50\nBob 100\nCharlie 75", "expected": "Bob 100\nCharlie 75\nAlice 50\n" },
      { "input": "2\nJon 10\nArya 99", "expected": "Arya 99\nJon 10\n" }
    ]
  }
}
