# ------------------------------------------------------------------------------
# CODE DUNGEON - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ------------------------------------------------------------------------------

# ─── SUPABASE SETTINGS (VITE REQ) ─────────────────────────────────────────────
# Description: Supabase project API URL.
# Required for: (Optional) If frontend handles client-side direct auth, though all main features go through the backend API.
# Values:
#   - https://[your-project-id].supabase.co
VITE_SUPABASE_URL=https://nmuqgeqssaoovuidpbxn.supabase.co

# Description: Supabase anonymous public API key.
# Values: Get from Supabase Project Settings > API > anon / public.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ─── API SETTINGS ─────────────────────────────────────────────────────────────
# Description: The URL endpoint of the Main Backend Express Server.
# Required for: Making HTTP requests (API calls for login, submissions, leaderboard).
# Where it's read: services/api.js, services/socket.js
# Error if wrong: "Failed to fetch" on login/registration.
# Values:
#   - Local Dev (same machine): http://localhost:5000
#   - LAN (hotspot/college Wi-Fi): http://[MAIN_SERVER_IP]:5000 (e.g. http://192.168.1.15:5000)
#   - Production (Vercel): https://codedungeon.onrender.com
VITE_API_URL=http://localhost:5000
