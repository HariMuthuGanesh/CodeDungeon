# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example          # Allow a safe example template to be committed

# ─── Build Output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# ─── Markdown Notes (internal docs, not for repo) ─────────────────────────────
*.md
!README.md             # Keep the project README

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.lock
coverage/
.cache/
.temp/
